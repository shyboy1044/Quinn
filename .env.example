# ─────────────────────────────────────────────────────────────
# Email Automation Tool — environment configuration
# Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# --- Database ---
# Dev default is a local SQLite file. For production use Postgres, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/emaildb"
DATABASE_URL="file:./dev.db"

# --- Public base URL (used to build unsubscribe links) ---
# In production this MUST be your real https domain, or one-click
# unsubscribe links will not work.
APP_BASE_URL="http://localhost:3000"

# --- Email sending: SMTP (Gmail / Outlook.com / any SMTP host) ---
# Leave SMTP_HOST/USER/PASS empty to run in DRY-RUN mode (no real emails).
#
# Gmail:        SMTP_HOST=smtp.gmail.com        SMTP_PORT=587
#   Requires an App Password (2-Step Verification must be on). ~500 recipients/day.
# Outlook.com:  SMTP_HOST=smtp-mail.outlook.com SMTP_PORT=587
#   Requires an App Password. ~300 recipients/day.
#
# NOTE: Gmail/Outlook prohibit unsolicited bulk email — cold-outreach volume
# risks account suspension. Keep DAILY_SEND_LIMIT low.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# secure=true only for port 465 (implicit TLS). Port 587 uses STARTTLS (leave false).
SMTP_SECURE="false"

# --- Compliance: legally-required sender identity ---
# CAN-SPAM requires a real physical postal address in every email.
# These are used to build the mandatory email footer.
SENDER_FROM_NAME="Your Company"
SENDER_FROM_EMAIL="outreach@yourdomain.com"
SENDER_REPLY_TO="you@yourdomain.com"
SENDER_POSTAL_ADDRESS="123 Example St, Suite 100, City, ST 00000, Country"

# --- Secret for signing unsubscribe tokens (any long random string) ---
UNSUBSCRIBE_SECRET="change-me-to-a-long-random-string"

# --- Throttling: protect sender reputation ---
# Max sends per mailbox per day (keep 20-50 for cold outreach).
DAILY_SEND_LIMIT="40"
# Milliseconds to wait between individual sends.
SEND_DELAY_MS="1500"

# --- GitHub research (public-email collection) ---
# A classic or fine-grained PAT raises the rate limit to 5,000 req/hr
# and is REQUIRED to read publicly-listed emails.
# Create at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=""
